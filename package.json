{
  "name": "pagescribe-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "epubjs": "0.3.93",
    "jszip": "3.10.1",
    "linkedom": "0.18.13",
    "mammoth": "1.13.0",
    "onnxruntime-web": "1.23.2",
    "pdfjs-dist": "6.4.299",
    "piexifjs": "1.0.6",
    "ppu-paddle-ocr": "6.6.0",
    "turndown": "7.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "$@xmldom/xmldom"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "pdf-lib": "1.17.1"
  },
  "license": "MIT"
}
